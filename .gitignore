# Dependencies
node_modules

# Build output (published to npm via package.json "files", not committed to git)
dist

# Logs & test coverage
*.log
coverage

# OS junk
.DS_Store

# Docker dev-harness build artifacts (regenerated by `npm run docker:pack`)
docker/*.tgz
docker/screenshots/debug/

# Claude Code local settings — machine-specific permissions, not shared
.claude/

# Superpowers SDD scratch/process artifacts (task reports, review diffs)
.superpowers/

# This project standardizes on npm (package-lock.json) — guard against stray
# lockfiles from other package managers.
pnpm-lock.yaml
yarn.lock
