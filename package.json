{
  "name": "n8n-nodes-app-store-connect",
  "version": "0.1.0",
  "description": "n8n community nodes for the Apple App Store Connect API (webhooks).",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "app-store-connect",
    "apple",
    "webhooks"
  ],
  "license": "MIT",
  "homepage": "https://github.com/mortocks/n8n-nodes-app-store-connect",
  "author": {
    "name": "Andrew Morton",
    "url": "https://github.com/mortocks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mortocks/n8n-nodes-app-store-connect.git"
  },
  "bugs": {
    "url": "https://github.com/mortocks/n8n-nodes-app-store-connect/issues"
  },
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials utils --write",
    "lint": "eslint --ext .ts nodes credentials package.json",
    "lintfix": "eslint --ext .ts nodes credentials package.json --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "docker:pack": "npm run build && rm -f docker/*.tgz && npm pack --pack-destination docker",
    "docker:refresh": "npm run docker:pack && docker compose -f docker/docker-compose.yml up -d --build --force-recreate",
    "prepublishOnly": "npm run build && npm run lint && npm run test"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/AppStoreConnectApi.credentials.js",
      "dist/credentials/AppStoreConnectWebhook.credentials.js"
    ],
    "nodes": [
      "dist/nodes/AppStoreConnect/AppStoreConnect.node.js",
      "dist/nodes/AppStoreConnectTrigger/AppStoreConnectTrigger.node.js",
      "dist/nodes/VerifyWebhookSignature/VerifyWebhookSignature.node.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "jest": "^29.7.0",
    "n8n-workflow": "*",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
